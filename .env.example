# Local development values only. Copy to `.env` and keep real secrets out of git.
# PostgreSQL comes from `docker compose up -d` (host port 55432 → container 5432).

# App role: what the running app uses (no DDL; grants come from migrations).
DATABASE_URL=postgres://acme_app:acme_app_local@127.0.0.1:55432/acme
# Owner role: migrations, reset, seed, verify and test setup only.
DATABASE_OWNER_URL=postgres://acme_owner:acme_owner_local@127.0.0.1:55432/acme

# Auth base URL and the only accepted Origin for tRPC mutations.
APP_URL=http://localhost:3000

# At least 32 characters each, and different from each other.
# Generate your own with: openssl rand -base64 32
BETTER_AUTH_SECRET=local-only-better-auth-secret-change-me-00
CURSOR_SECRET=local-only-cursor-secret-change-me-0000000

# Seeded demo HR account (shown on the login page; synthetic data only).
DEMO_HR_EMAIL=hr@acme.test
DEMO_HR_PASSWORD=demo-hr-password-local
