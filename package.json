{
  "name": "acme-salary-management",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:db": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --project db",
    "test:e2e": "playwright test",
    "db:generate": "tsx --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/db/migrate.ts",
    "db:reset": "tsx --env-file-if-exists=.env scripts/db/reset.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/db/seed.ts",
    "db:verify": "tsx --env-file-if-exists=.env scripts/db/verify.ts",
    "bench": "tsx --env-file-if-exists=.env scripts/bench-reports.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.11",
    "@tanstack/react-query": "5.104.5",
    "@trpc/client": "11.19.0",
    "@trpc/server": "11.19.0",
    "@trpc/tanstack-react-query": "11.19.0",
    "better-auth": "1.7.11",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
